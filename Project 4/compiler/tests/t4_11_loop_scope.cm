/* Expected output: 0  150  3  7
 * A variable declared INSIDE a loop body is a new variable with its own
 * frame slot (tac.c renames it i__1 -- look for "[SCOPE]" in the trace).
 * Assigning it must never disturb the outer variable of the same name, and
 * the loop's own counter keeps counting correctly underneath it.
 * Before the Project 4 fix both i's shared one slot and this printed 50. */
int main() {
    int i; int j; int n;
    i = 0; j = 100;
    while (i < 3) {
        int i;          /* shadows the outer i for the body only */
        i = 50;
        j = j + i;
        break;
    }
    print(i);           /* 0   -- the outer i was never touched    */
    print(j);           /* 150 */
    n = 0;
    for (i = 0; i < 3; i = i + 1) {
        int n;          /* a fresh n each time round, outer n untouched */
        n = 7;
    }
    print(i);           /* 3 */
    n = n + 7;
    print(n);           /* 7 */
    return 0;
}
