/* Expected output: 0  7
 * Loop test at the TOP: the condition is false initially, so the body must
 * run zero times (a test-at-bottom lowering would print 1 here). */
int main() {
    int i; int n;
    n = 0; i = 5;
    while (i < 3) { n = n + 1; i = i + 1; }
    print(n);
    for (i = 7; i < 3; i = i + 1) { n = 99; }
    print(i);
    return 0;
}
