/* Expected output: 10100
 * BENCHMARK with a hot loop: sum of 2*i for i in 1..200, with deliberately
 * redundant arithmetic the optimizer can strip (x+0, x*1, constant 2*50-100). */
int main() {
    int i; int s; int k;
    s = 0;
    k = 2 * 50 - 100;               /* folds to 0 */
    for (i = 1; i <= 100; i = i + 1) {
        s = s + (i * 1 + k) * 2;    /* i*1, +0 vanish after propagation */
    }
    print(s);                       /* 2 * 5050 = 10100 ... 2 * 5050 */
    return 0;
}
