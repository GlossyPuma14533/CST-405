/* Expected output: 30  16  5
 * A Topic 2 style program -- statements at FILE scope, no main() -- now with
 * loops.  The statements (loops included) are gathered into an implicit
 * main(); i and s are globals living in .data.  This is the Project 3
 * compatibility rule carried forward to Topic 4. */
int i;
int s;
s = 0;
for (i = 1; i <= 4; i = i + 1) { s = s + i * i; }
print(s);                       /* 1 + 4 + 9 + 16 = 30 */
while (s > 20) s = s - 7;
print(s);                       /* 30 -> 23 -> 16 */
print(i);                       /* 5 */
